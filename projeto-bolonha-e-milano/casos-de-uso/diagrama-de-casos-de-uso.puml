@startuml
title Bolonha e Milano - Casos de uso (Etapas 3 e 4 cumulativas)
left to right direction
actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Comprar graos" as UC31
  usecase "Vender graos" as UC32
  usecase "Comprar terras" as UC33
  usecase "Vender terras" as UC34
  usecase "Acessar agricultura" as UC4
  usecase "Colher (processar safra)" as UC41
  usecase "Distribuir alimentos" as UC42
  usecase "Ver informacoes sobre o jogo" as UC5
  usecase "Sair do jogo" as UC6
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
Jogador --> UC6

UC31 ..> UC3 : <<extend>>
UC32 ..> UC3 : <<extend>>
UC33 ..> UC3 : <<extend>>
UC34 ..> UC3 : <<extend>>

UC41 ..> UC4 : <<extend>>
UC42 ..> UC4 : <<extend>>

@enduml
