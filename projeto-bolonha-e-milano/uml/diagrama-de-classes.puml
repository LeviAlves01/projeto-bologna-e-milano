@startuml
title Bolonha e Milano - Diagrama de classes (Etapa 2)
skinparam classAttributeIconSize 0

class Main {
  + main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  - jogador: Jogador
  - cidade: Cidade
  + executar(): void
  - iniciarNovoJogo(): void
  - exibirStatusCidade(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - processarOpcao(opcao: int): void
  - exibirSobre(): void
}

class Jogador {
  - nome: String
  - titulo: String
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  + Cidade(nome: String, dono: Jogador)
  + avancarAno(): void
  + exibirStatus(): void
}

Main ..> Menu : cria e usa
Menu --> "0..1" Jogador
Menu --> "0..1" Cidade
Cidade --> "1" Jogador : dono
@enduml
