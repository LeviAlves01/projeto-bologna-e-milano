@startuml
title Bolonha e Milano - Diagrama de classes (Etapas 1 a 8 cumulativas + eventos aleatorios)
skinparam classAttributeIconSize 0

class Main {
  + {static} main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  - partida: Partida
  - cidade: Cidade
  - mercado: Mercado
  - agricultura: Agricultura
  - governo: Governo
  - construcoes: Construcoes
  - nobreza: Nobreza
  - eventos: Eventos
  + executar(): void
  - limparTela(): void
  - exibirCabecalho(): void
  - pausar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - lerInteiro(): int
  - lerQuantidade(): int
  - lerTexto(pergunta: String): String
  - exigirJogoEmAndamento(): boolean
  - processarOpcao(opcao: int): void
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - abrirMercado(): void
  - comprarGraos(): void
  - venderGraos(): void
  - comprarTerras(): void
  - venderTerras(): void
  - abrirAgricultura(): void
  - colher(): void
  - distribuirAlimentos(): void
  - abrirGoverno(): void
  - arrecadarImpostos(): void
  - definirTaxaImposto(): void
  - definirJustica(): void
  - abrirConstrucoes(): void
  - recrutarSoldados(): void
  - construir(): void
  - encerrarTurno(): void
  - sortearEventosDoAno(): void
  - exibirClassificacao(): void
  - encerrarPartida(): void
  - exibirSobre(): void
}

class Partida {
  + {static} MAXIMO_JOGADORES: int = 4
  - {static} ANO_FINAL: int = 1410
  - cidades: List<Cidade>
  - indiceAtual: int
  + Partida()
  + adicionarCidade(cidade: Cidade): boolean
  + getCidades(): List<Cidade>
  + getCidadeAtual(): Cidade
  + getAnoAtual(): int
  + getAnoFinal(): int
  + passarTurno(): boolean
  + encerrarAno(nobreza: Nobreza): List<Cidade>
  + terminou(): boolean
  + determinarVencedor(nobreza: Nobreza): Cidade
  - ehMelhor(candidata: Cidade, atual: Cidade, nobreza: Nobreza): boolean
}

class Jogador {
  - {static} TITULOS: String[]
  - nome: String
  - nivelTitulo: int
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
  + getNivelTitulo(): int
  + promover(): boolean
  + ehMonarca(): boolean
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins: int
  - terras: int
  - graos: int
  - servos: int
  - taxaImposto: int
  - nivelJustica: String
  - soldados: int
  - construcoes: int
  - colheitaFeita: boolean
  - impostosArrecadados: boolean
  + Cidade(nome: String, dono: Jogador)
  + getNome(): String
  + getAnoAtual(): int
  + getDono(): Jogador
  + avancarAno(): void
  + isColheitaFeita(): boolean
  + marcarColheitaFeita(): void
  + isImpostosArrecadados(): boolean
  + marcarImpostosArrecadados(): void
  + getFlorins(): int
  + getTerras(): int
  + getGraos(): int
  + getServos(): int
  + getSoldados(): int
  + getConstrucoes(): int
  + getTaxaImposto(): int
  + setTaxaImposto(taxa: int): void
  + getNivelJustica(): String
  + setNivelJustica(nivel: String): void
  + adicionarFlorins(qtd: int): void
  + removerFlorins(qtd: int): boolean
  + adicionarTerras(qtd: int): void
  + removerTerras(qtd: int): boolean
  + adicionarGraos(qtd: int): void
  + removerGraos(qtd: int): boolean
  + adicionarServos(qtd: int): void
  + removerServos(qtd: int): boolean
  + adicionarSoldados(qtd: int): void
  + removerSoldados(qtd: int): boolean
  + adicionarConstrucoes(qtd: int): void
  + removerConstrucoes(qtd: int): boolean
  + exibirStatus(): void
}

class Mercado {
  - PRECO_GRAO: int
  - PRECO_TERRA: int
  + getPrecoGrao(): int
  + getPrecoTerra(): int
  + comprarGraos(c: Cidade, qtd: int): boolean
  + venderGraos(c: Cidade, qtd: int): boolean
  + comprarTerras(c: Cidade, qtd: int): boolean
  + venderTerras(c: Cidade, qtd: int): boolean
}

class Agricultura {
  - HECTARES_POR_SERVO: int
  - RENDIMENTO_POR_HECTARE: int
  - SERVOS_POR_GRAO: int
  - CRESCIMENTO_PERCENTUAL: int
  - PERCENTUAL_MINIMO: int
  - PERCENTUAL_MAXIMO: int
  + processarColheita(cidade: Cidade): int
  + distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}

class Governo {
  - TAXA_MAXIMA: int
  - MULTIPLICADOR_JUSTA: double
  - MULTIPLICADOR_MODERADA: double
  - MULTIPLICADOR_SEVERA: double
  + arrecadarImpostos(cidade: Cidade): int
  + definirTaxaImposto(cidade: Cidade, taxa: int): boolean
  + definirJustica(cidade: Cidade, nivel: String): boolean
  - multiplicadorPara(nivel: String): double
}

class Construcoes {
  - PRECO_SOLDADO: int
  - SERVOS_POR_SOLDADO: int
  - PRECO_CONSTRUCAO: int
  + recrutarSoldados(cidade: Cidade, qtd: int): boolean
  + construir(cidade: Cidade, qtd: int): boolean
  + getPrecoSoldado(): int
  + getPrecoConstrucao(): int
}

class Nobreza {
  - PESO_CONSTRUCAO: int = 10
  - PESO_SOLDADO: int = 2
  - PESO_SERVO: int = 1
  - HECTARES_POR_PONTO: int = 100
  - PRESTIGIO_MINIMO: int[] = {0, 400, 550, 700, 850, 1000}
  + calcularPrestigio(cidade: Cidade): int
  + prestigioParaProximoTitulo(jogador: Jogador): int
  + verificarPromocao(cidade: Cidade): boolean
}

class Eventos {
  + {static} TIPO_NENHUM: int = 0
  + {static} TIPO_SECA: int = 1
  + {static} TIPO_PESTE: int = 2
  - {static} CHANCE_SECA: int = 15
  - {static} CHANCE_PESTE: int = 10
  - {static} PERCENTUAL_PERDA_SECA: int = 40
  - {static} PERCENTUAL_PERDA_PESTE: int = 20
  - random: Random
  + Eventos()
  + Eventos(random: Random)
  + sortearEvento(cidade: Cidade): int
  + aplicarSeca(cidade: Cidade): int
  + aplicarPeste(cidade: Cidade): int
}

class Testes {
  - {static} aprovados: int
  - {static} reprovados: int
  + {static} main(args: String[]): void
  - {static} verificar(descricao: String, condicao: boolean): void
  - {static} novaCidade(): Cidade
  - {static} testarCidade(): void
  - {static} testarMercado(): void
  - {static} testarAgricultura(): void
  - {static} testarGoverno(): void
  - {static} testarConstrucoes(): void
  - {static} testarJogadorENobreza(): void
  - {static} testarPartida(): void
  - {static} eventosComSorteio(valor: int): Eventos
  - {static} testarEventos(): void
}

Main ..> Menu : cria e usa
Menu --> "0..1" Partida
Menu --> "0..1" Cidade : cidade da vez
Menu --> "1" Mercado : usa
Menu --> "1" Agricultura : usa
Menu --> "1" Governo : usa
Menu --> "1" Construcoes : usa
Menu --> "1" Nobreza : usa
Menu --> "1" Eventos : usa
Partida --> "1..4" Cidade : cidades
Partida --> "1" Cidade : vez atual
Cidade --> "1" Jogador : dono
Mercado ..> Cidade : usa como parametro
Agricultura ..> Cidade : usa como parametro
Governo ..> Cidade : usa como parametro
Construcoes ..> Cidade : usa como parametro
Nobreza ..> Cidade : usa como parametro
Eventos ..> Cidade : usa como parametro
Nobreza ..> Jogador : usa como parametro
Partida ..> Nobreza : usa como parametro
Testes ..> Cidade : testa
Testes ..> Mercado : testa
Testes ..> Agricultura : testa
Testes ..> Governo : testa
Testes ..> Construcoes : testa
Testes ..> Nobreza : testa
Testes ..> Jogador : testa
Testes ..> Partida : testa
Testes ..> Eventos : testa

@enduml